{
  "name": "botamochi-dev-web",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "prepare": "husky",
    "skills:sync": "node scripts/sync-skills.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "astro-seo": "^1.2.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/partytown": "^2.1.9",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
