---
import GameLayout from '~/layouts/GameLayout.astro';
import MenuList from '~/components/game/MenuList.astro';
import PreviewPane from '~/components/game/PreviewPane.astro';

import { PROFILE, SKILLS, TOP_MENU } from '~/data/profile';
import { fetchWorks } from '~/utils/works';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const works = await fetchWorks();
const posts = (await fetchPosts()).slice(0, 3);

const items = TOP_MENU.map((t) => ({
  href: getPermalink(t.path),
  label: t.label,
  ariaLabel: `${t.label}（${t.ja}）`,
  preview: t.id,
}));
---

<GameLayout
  metadata={{ title: `${PROFILE.name} のポートフォリオ`, ignoreTitleTemplate: true }}
  crumb={[{ label: 'MENU' }]}
  hints="menu"
>
  <div class="screen">
    <div class="menu-col">
      <p class="band">
        <b>{PROFILE.name}</b>
        {PROFILE.role} {PROFILE.tagline}
      </p>
      <MenuList items={items} size="xl" label="メインメニュー" />
    </div>
    <PreviewPane>
      <section data-preview-for="works">
        <div class="k">WORKS</div>
        <h2>作品 {works.length} 点</h2>
        <p>ゲーム、グラフィックス、ツール、Web に分けて並べています。</p>
        <ul>
          {works.slice(0, 3).map((w) => (
            <li>{w.data.title}</li>
          ))}
        </ul>
      </section>
      <section data-preview-for="about" hidden>
        <div class="k">ABOUT</div>
        <h2>{PROFILE.name}</h2>
        <p>{PROFILE.role}</p>
        <p>{PROFILE.tagline}</p>
      </section>
      <section data-preview-for="skills" hidden>
        <div class="k">SKILLS</div>
        <h2>できること</h2>
        <p>
          {SKILLS.slice(0, 6)
            .map((s) => s.name)
            .join('、')}{' '}
          など
        </p>
      </section>
      <section data-preview-for="blog" hidden>
        <div class="k">BLOG</div>
        <h2>ブログ</h2>
        <ul>
          {posts.map((p) => (
            <li>{p.title}</li>
          ))}
        </ul>
      </section>
      <section data-preview-for="contact" hidden>
        <div class="k">CONTACT</div>
        <h2>連絡先</h2>
        <p>{PROFILE.email || '[メールアドレス]'}</p>
        <p>GitHub：{PROFILE.githubName}</p>
      </section>
    </PreviewPane>
  </div>
</GameLayout>
