---
import GameLayout from '~/layouts/GameLayout.astro';
import MenuList from '~/components/game/MenuList.astro';
import PreviewPane from '~/components/game/PreviewPane.astro';

import { PROFILE } from '~/data/profile';
import { getHomePermalink } from '~/utils/permalinks';

const email = PROFILE.email;

const items = [
  email
    ? { href: `mailto:${email}`, label: 'メールアドレスをコピー', preview: 'mail', copy: email }
    : { href: '#', label: 'メールアドレスをコピー', preview: 'mail', notice: 'メールアドレスは準備中です' },
  { href: PROFILE.github, label: 'GitHub', preview: 'github' },
  PROFILE.pdf
    ? { href: PROFILE.pdf, label: 'ポートフォリオ PDF', preview: 'pdf' }
    : { href: '#', label: 'ポートフォリオ PDF', preview: 'pdf', notice: 'PDF は準備中です' },
];
---

<GameLayout
  metadata={{ title: '連絡先', description: 'botamochi への連絡先です。' }}
  crumb={[{ label: 'MENU', href: getHomePermalink() }, { label: 'CONTACT' }]}
  hints="list"
  parent={getHomePermalink()}
>
  <div class="screen">
    <div class="menu-col">
      <MenuList items={items} size="l" label="連絡先" />
    </div>
    <PreviewPane>
      <section data-preview-for="mail">
        <div class="k">MAIL</div>
        <h2 class="select-all">{email || '[メールアドレス]'}</h2>
        <p>{email ? '決定するとコピーします。' : '公開用のアドレスを準備しています。'}</p>
      </section>
      <section data-preview-for="github" hidden>
        <div class="k">GITHUB</div>
        <h2>{PROFILE.githubName}</h2>
        <p>コードはここにあります。新しいタブで開きます。</p>
      </section>
      <section data-preview-for="pdf" hidden>
        <div class="k">PDF</div>
        <h2>ポートフォリオ PDF</h2>
        <p>{PROFILE.pdf ? '応募用の PDF です。' : '[応募用の PDF。サイトと同じ内容を紙でも読めるようにする]'}</p>
      </section>
    </PreviewPane>
  </div>
</GameLayout>
