---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, getStaticPathsBlogTag } from '~/utils/blog';

import GameLayout from '~/layouts/GameLayout.astro';
import PostMenu from '~/components/game/PostMenu.astro';

import { getBlogPermalink, getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `タグ「${tag.title}」${currentPage > 1 ? `（${currentPage} ページ目）` : ''}`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<GameLayout
  metadata={metadata}
  crumb={[
    { label: 'MENU', href: getHomePermalink() },
    { label: 'BLOG', href: getBlogPermalink() },
    { label: tag.title },
  ]}
  hints="list"
  parent={getBlogPermalink()}
>
  <PostMenu posts={page.data} label={`タグ「${tag.title}」の記事`} prevUrl={page.url.prev} nextUrl={page.url.next} />
</GameLayout>
