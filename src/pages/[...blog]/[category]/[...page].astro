---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import GameLayout from '~/layouts/GameLayout.astro';
import PostMenu from '~/components/game/PostMenu.astro';

import { getBlogPermalink, getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `分類「${category.title}」${currentPage > 1 ? `（${currentPage} ページ目）` : ''}`,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<GameLayout
  metadata={metadata}
  crumb={[
    { label: 'MENU', href: getHomePermalink() },
    { label: 'BLOG', href: getBlogPermalink() },
    { label: category.title },
  ]}
  hints="list"
  parent={getBlogPermalink()}
>
  <PostMenu
    posts={page.data}
    label={`分類「${category.title}」の記事`}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
  />
</GameLayout>
