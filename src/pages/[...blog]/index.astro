---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import GameLayout from '~/layouts/GameLayout.astro';
import MenuList from '~/components/game/MenuList.astro';

import { getBlogPermalink, getCanonical, getHomePermalink, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

const blogHref = getBlogPermalink();
---

<GameLayout
  metadata={metadata}
  crumb={[{ label: 'MENU', href: getHomePermalink() }, { label: 'BLOG', href: blogHref }, { label: post.title }]}
  hints="page"
  parent={blogHref}
>
  <article class="page article">
    <p class="meta-line">
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
      {post.category && (
        <>
          <a class="ml-4" href={getPermalink(post.category.slug, 'category')}>
            {post.category.title}
          </a>
        </>
      )}
      {post.readingTime && <span class="ml-4">{post.readingTime} 分で読めます</span>}
    </p>
    <h1 class="article-title">{post.title}</h1>
    <div class="prose prose-game max-w-none">{post.Content && <post.Content />}</div>
    {post.tags && post.tags.length > 0 && (
      <ul class="chips mt-8 list-none p-0" aria-label="タグ">
        {post.tags.map((t) => (
          <li>
            <a class="chip no-underline" href={getPermalink(t.slug, 'tag')}>
              {t.title}
            </a>
          </li>
        ))}
      </ul>
    )}
    <MenuList
      class="endmenu"
      size="m"
      label="記事の移動"
      enter={false}
      items={[
        { href: blogHref, label: 'ブログ一覧に戻る' },
        { href: getHomePermalink(), label: 'メニューに戻る' },
      ]}
    />
  </article>
</GameLayout>
