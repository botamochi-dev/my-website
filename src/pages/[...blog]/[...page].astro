---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import GameLayout from '~/layouts/GameLayout.astro';
import PostMenu from '~/components/game/PostMenu.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getHomePermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `ブログ${currentPage > 1 ? `（${currentPage} ページ目）` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<GameLayout
  metadata={metadata}
  crumb={[{ label: 'MENU', href: getHomePermalink() }, { label: 'BLOG' }]}
  hints="list"
  parent={getHomePermalink()}
>
  <PostMenu posts={page.data} label="ブログの記事" prevUrl={page.url.prev} nextUrl={page.url.next} />
</GameLayout>
