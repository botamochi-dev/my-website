---
import GameLayout from '~/layouts/GameLayout.astro';
import MenuList from '~/components/game/MenuList.astro';

import { PROFILE } from '~/data/profile';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';
---

<GameLayout
  metadata={{ title: 'わたしについて', description: `${PROFILE.name} の自己紹介です。` }}
  crumb={[{ label: 'MENU', href: getHomePermalink() }, { label: 'ABOUT' }]}
  hints="page"
  parent={getHomePermalink()}
>
  <div class="page">
    <h1 class="page-title">{PROFILE.name}</h1>
    <div class="cols">
      <div class="cols-main">
        <p class="lead">
          {PROFILE.role}。{PROFILE.tagline}
        </p>
        <h2>これまで</h2>
        <ul class="hist">
          {PROFILE.history.map((h) => (
            <li>
              <time>{h.date}</time>
              <span>{h.text}</span>
            </li>
          ))}
        </ul>
        <h2>好きなゲーム</h2>
        <p>{PROFILE.favoriteGames}</p>
      </div>
      <aside class="cols-aside" aria-label="プロフィール">
        <div class="statbox">
          <dl class="info">
            <dt>名前</dt>
            <dd>{PROFILE.name}</dd>
            <dt>目指す職種</dt>
            <dd>{PROFILE.role}</dd>
            <dt>所属</dt>
            <dd>{PROFILE.affiliation}</dd>
            <dt>得意</dt>
            <dd>{PROFILE.strengths}</dd>
          </dl>
        </div>
      </aside>
    </div>
    <MenuList
      class="endmenu"
      size="m"
      label="次の画面"
      enter={false}
      items={[
        { href: getPermalink('skills'), label: 'できることを見る' },
        { href: getPermalink('contact'), label: '連絡先へ' },
        { href: getHomePermalink(), label: 'メニューに戻る' },
      ]}
    />
  </div>
</GameLayout>
