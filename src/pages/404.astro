---
import GameLayout from '~/layouts/GameLayout.astro';
import MenuList from '~/components/game/MenuList.astro';

import { getHomePermalink } from '~/utils/permalinks';
---

<GameLayout
  metadata={{ title: 'ページが見つかりません', robots: { index: false } }}
  crumb={[{ label: 'MENU', href: getHomePermalink() }, { label: 'NOT FOUND' }]}
  hints="list"
  parent={getHomePermalink()}
>
  <div class="page game-over">
    <h1>
      STAGE
      <br />
      NOT FOUND
    </h1>
    <p>このページは見つかりませんでした。</p>
    <MenuList size="m" label="移動" items={[{ href: getHomePermalink(), label: 'メニューに戻る' }]} />
  </div>
</GameLayout>
