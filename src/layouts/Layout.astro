---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';

import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} transition:animate="none">
  <head>
    <CommonMeta />
    <Favicons />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&family=Roboto+Flex:wdth,wght@25..151,100..1000&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
    />

    <!-- 「動きを減らす」の設定を、描画の前に反映する（ちらつきを防ぐ） -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        let calm = false;
        try {
          calm = localStorage.getItem('game:calm') === '1';
        } catch {
          calm = false;
        }
        if (calm || window.matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('calm');
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>

  <body>
    <slot />
  </body>
</html>
